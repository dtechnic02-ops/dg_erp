<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <!--
        ③-H is an orchestration-only gate over the focused tests that own each
        rule. Keep detailed assertions in those tests instead of duplicating
        them in a single procedural compliance test.
    -->
    <testsuites>
        <testsuite name="Nepal fiscal foundations">
            <file>tests/Feature/NepalIrdCbmsModeFoundationTest.php</file>
            <file>tests/Feature/NepalTaxIdentityFoundationTest.php</file>
            <file>tests/Feature/SalesTaxClassificationFoundationTest.php</file>
            <file>tests/Feature/GlobalAdBsRolloutTest.php</file>
            <file>tests/Feature/SalesInvoiceAdBsPilotTest.php</file>
            <file>tests/Unit/NepaliDateServiceTest.php</file>
        </testsuite>

        <testsuite name="Fiscal evidence and output">
            <file>tests/Feature/NepalFiscalDocumentImmutabilityTest.php</file>
            <file>tests/Feature/SalesFiscalLineDiscountFoundationTest.php</file>
            <file>tests/Feature/SalesInvoiceOriginalReprintControlTest.php</file>
            <file>tests/Feature/SalesFiscalReportTest.php</file>
            <file>tests/Unit/SalesFiscalPaymentPresentationTest.php</file>
            <file>tests/Unit/SalesFiscalReadinessServiceTest.php</file>
            <file>tests/Unit/SalesFiscalReconciliationServiceTest.php</file>
        </testsuite>

        <testsuite name="Fiscal protection and isolation">
            <file>tests/Feature/AuditorRoleTest.php</file>
            <file>tests/Feature/FiscalHistoryDeletionProtectionTest.php</file>
            <file>tests/Feature/CompanyFactoryResetTest.php</file>
            <file>tests/Feature/CompanyPermanentDeletionTest.php</file>
            <file>tests/Feature/GlobalCountryAdministrationTest.php</file>
            <file>tests/Feature/DashboardCountryIsolationTest.php</file>
            <file>tests/Feature/CbmsApiConfigurationFoundationTest.php</file>
            <file>tests/Feature/VatPermissionTest.php</file>
            <file>tests/Feature/SecurityPermissionArchitectureTest.php</file>
        </testsuite>

        <testsuite name="Sales accounting stock and legacy">
            <file>tests/Feature/SalesValidationPreservationTest.php</file>
            <file>tests/Feature/SalesCogsInventoryAccountingTest.php</file>
            <file>tests/Feature/SalesPaymentAccountingTest.php</file>
            <file>tests/Feature/SalesCancellationReturnValuationTest.php</file>
            <file>tests/Feature/SalesReturnRefundAccountingTest.php</file>
            <file>tests/Feature/Company/SalesReturnAndDuplicateCancellationTest.php</file>
            <file>tests/Feature/Company/SalesReturnRefundControllerTest.php</file>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
